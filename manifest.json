{
  "manifest_version": 3,
  "name": "Insta Handle & Creator Exporter",
  "version": "2.0.0",
  "description": "Instagram profiles & post scraper with date filter & early cutoff, IG creator discovery via suggestion graph, YouTube exporter, and campaign brief parser. Fast, safe, and rate-limit aware.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "offscreen",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://i.instagram.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Insta Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
